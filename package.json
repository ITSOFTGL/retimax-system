{
  "name": "retimax-system",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @retimax/api dev",
    "dev:web": "pnpm --filter @retimax/web dev",
    "dev:web:clean": "pnpm --filter @retimax/web clean && pnpm dev:web",
    "start:web": "pnpm --filter @retimax/web start",
    "start:api": "pnpm --filter @retimax/api start",
    "verify": "pnpm exec turbo run build --filter=@retimax/api --filter=@retimax/web --filter=@retimax/shared-types --force",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:migrate": "pnpm --filter @retimax/api exec prisma migrate deploy",
    "db:seed": "pnpm --filter @retimax/api exec prisma db seed",
    "db:generate": "pnpm --filter @retimax/api exec prisma generate",
    "setup": "pnpm install && pnpm db:generate && pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "sharp"]
  }
}
